<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI への指示。評価（evals/Revalue.Evals）からも同じファイルを読むので、出力と publish にコピーする -->
    <None Update="Ai\Prompts\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 登録した職種と業務、使わない言葉の一覧、能力辞書は、起動時に埋め込みのリソースから読む -->
    <EmbeddedResource Include="Features\Options\jobs.json" LogicalName="jobs.json" />
    <EmbeddedResource Include="..\shared\forbidden-words.json" LogicalName="forbidden-words.json" />
    <EmbeddedResource Include="..\shared\abilities.json" LogicalName="abilities.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Revalue.Server.Tests" />
  </ItemGroup>

</Project>
