    { "id": "t82", "scene": "s01", "kind": "caption", "text": "また働きたいと思ったとき", "start": 0.15, "end": 13.4 },
    { "id": "t83", "scene": "s01", "kind": "caption", "text": "何から相談すればいいのだろう", "start": 3.0, "end": 13.4 },
    { "id": "t84", "scene": "s01", "kind": "caption", "text": "自分にどんな仕事ができるのだろう", "start": 5.9, "end": 13.4 },
    { "id": "t85", "scene": "s01", "kind": "caption", "text": "希望は、どこで話せばいいのだろう", "start": 9.2, "end": 13.4 },

    { "id": "t01", "scene": "s01", "kind": "caption", "text": "第 1 子の妊娠がわかったときに働いていた既婚女性のうち、子どもが 1 歳のときには仕事を離れていた人", "start": 13.7, "end": 24.9 },
    { "id": "t02", "scene": "s01", "kind": "label", "text": "全体", "start": 14.2, "end": 24.9 },
    { "id": "t03", "scene": "s01", "kind": "title", "text": "約 5 人に 1 人", "start": 14.5, "end": 24.9 },
    { "id": "t04", "scene": "s01", "kind": "label", "text": "1 歳のときも仕事を続けていた 80.5%", "start": 15.5, "end": 24.9 },
    { "id": "t05", "scene": "s01", "kind": "label", "text": "パート・派遣等", "start": 18.3, "end": 24.9 },
    { "id": "t06", "scene": "s01", "kind": "title", "text": "4 割以上", "start": 18.6, "end": 24.9 },
    { "id": "t07", "scene": "s01", "kind": "label", "text": "1 歳のときも仕事を続けていた 56.0%", "start": 19.6, "end": 24.9 },
    { "id": "t09", "scene": "s01", "kind": "label", "text": "第 17 回出生動向基本調査（国立社会保障・人口問題研究所）。第 1 子の生まれ年 2020〜24 年。育休中は続けていた側", "start": 13.9, "end": 24.9 },

    { "id": "t10", "scene": "s01", "kind": "caption", "text": "仕事を離れた時間は、履歴書では", "start": 25.0, "end": 29.2 },
    { "id": "t11", "scene": "s01", "kind": "title", "text": "空白に見られることも", "start": 25.9, "end": 29.2 },
    { "id": "t81", "scene": "s01", "kind": "title", "text": "職歴には載らない力", "start": 29.5, "end": 34.9 },

