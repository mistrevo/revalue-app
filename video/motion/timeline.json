  "texts": [
    { "id": "t01", "scene": "s01", "kind": "caption", "text": "第 1 子の妊娠がわかったときに働いていた人のうち、子どもが 1 歳のときには働いていない人", "start": 0.2, "end": 13.4 },
    { "id": "t02", "scene": "s01", "kind": "label", "text": "全体", "start": 0.7, "end": 13.4 },
    { "id": "t03", "scene": "s01", "kind": "title", "text": "約 5 人に 1 人", "start": 1.0, "end": 13.4 },
    { "id": "t04", "scene": "s01", "kind": "label", "text": "1 歳のときも働いていた 80.5%", "start": 2.0, "end": 13.4 },
    { "id": "t05", "scene": "s01", "kind": "label", "text": "パート・派遣等", "start": 6.8, "end": 13.4 },
    { "id": "t06", "scene": "s01", "kind": "title", "text": "4 割以上", "start": 7.1, "end": 13.4 },
    { "id": "t07", "scene": "s01", "kind": "label", "text": "1 歳のときも働いていた 56.0%", "start": 8.1, "end": 13.4 },
    { "id": "t09", "scene": "s01", "kind": "label", "text": "第 17 回出生動向基本調査（国立社会保障・人口問題研究所）。第 1 子の生まれ年 2020〜24 年", "start": 0.4, "end": 13.4 },
    { "id": "t10", "scene": "s01", "kind": "caption", "text": "その間の暮らしは、履歴書では", "start": 13.7, "end": 19.9 },
    { "id": "t11", "scene": "s01", "kind": "title", "text": "空白", "start": 14.3, "end": 19.9 },
    { "id": "t12", "scene": "s01", "kind": "caption", "text": "力として説明できず、相談にも行きにくい", "start": 15.4, "end": 19.9 },

    { "id": "t20", "scene": "s02", "kind": "title", "text": "RE:VALUE", "start": 20.05, "end": 29.9 },
    { "id": "t21", "scene": "s02", "kind": "caption", "text": "AI が聞き手になり、どの仕事に進むかは本人が選ぶ", "start": 20.4, "end": 29.9 },
    { "id": "t22", "scene": "s02", "kind": "caption", "text": "話す", "start": 21.2, "end": 29.9 },
    { "id": "t23", "scene": "s02", "kind": "label", "text": "AI が聞き手になる", "start": 21.35, "end": 29.9 },
    { "id": "t24", "scene": "s02", "kind": "caption", "text": "確かめる", "start": 22.8, "end": 29.9 },
    { "id": "t25", "scene": "s02", "kind": "label", "text": "本人の言葉を根拠に", "start": 22.95, "end": 29.9 },
    { "id": "t26", "scene": "s02", "kind": "caption", "text": "選択肢を広げる", "start": 24.4, "end": 29.9 },
    { "id": "t27", "scene": "s02", "kind": "label", "text": "使える時間と場所の中で", "start": 24.55, "end": 29.9 },
    { "id": "t28", "scene": "s02", "kind": "caption", "text": "本人が選ぶ", "start": 26.0, "end": 29.9 },
    { "id": "t29", "scene": "s02", "kind": "label", "text": "直す・保留する・自分で書く", "start": 26.15, "end": 29.9 },

    { "id": "t30", "scene": "s05", "kind": "caption", "text": "根拠のそろっていない 109 の力のうち、強みとして挙げた数", "start": 30.15, "end": 41.4 },
    { "id": "t31", "scene": "s05", "kind": "label", "text": "汎用の AI（特別な指示なし）", "start": 30.6, "end": 41.4 },
    { "id": "t32", "scene": "s05", "kind": "title", "text": "22 件", "start": 32.3, "end": 41.4 },
    { "id": "t33", "scene": "s05", "kind": "label", "text": "RE:VALUE", "start": 33.4, "end": 41.4 },
    { "id": "t34", "scene": "s05", "kind": "title", "text": "0 件", "start": 34.2, "end": 41.4 },
    { "id": "t35", "scene": "s05", "kind": "label", "text": "架空のエピソードで評価（2026-11-05）", "start": 30.8, "end": 41.4 },
    { "id": "t36", "scene": "s05", "kind": "title", "text": "コードが決めて、AI が言葉にする", "start": 41.7, "end": 54.9 },
    { "id": "t37", "scene": "s05", "kind": "caption", "text": "AI が読み取る", "start": 42.7, "end": 54.9 },
    { "id": "t38", "scene": "s05", "kind": "label", "text": "答えの種類と、根拠の候補", "start": 42.85, "end": 54.9 },
    { "id": "t39", "scene": "s05", "kind": "caption", "text": "コードが照らし合わせ、次の一手を決める", "start": 44.6, "end": 54.9 },
    { "id": "t40", "scene": "s05", "kind": "label", "text": "本人の発言と一字一句同じか", "start": 44.85, "end": 54.9 },
    { "id": "t41", "scene": "s05", "kind": "caption", "text": "AI が言葉にする", "start": 47.0, "end": 54.9 },
    { "id": "t42", "scene": "s05", "kind": "label", "text": "決まった次の一手だけを受け取る", "start": 47.15, "end": 54.9 },
    { "id": "t43", "scene": "s05", "kind": "label", "text": "「先に実家の母に電話して、空いている時間を聞きました」", "start": 49.0, "end": 54.9 },
    { "id": "t44", "scene": "s05", "kind": "caption", "text": "合わなければ、使わない", "start": 49.6, "end": 54.9 },

    { "id": "t50", "scene": "s06", "kind": "title", "text": "Claude Code を中心に作る", "start": 55.05, "end": 84.9 },
    { "id": "t51", "scene": "s06", "kind": "caption", "text": "人が決める", "start": 55.3, "end": 84.9 },
    { "id": "t52", "scene": "s06", "kind": "caption", "text": "AI が仕様と実装", "start": 55.36, "end": 84.9 },
    { "id": "t53", "scene": "s06", "kind": "caption", "text": "別の AI がレビュー", "start": 55.42, "end": 84.9 },
    { "id": "t54", "scene": "s06", "kind": "caption", "text": "結論を壊しにいく", "start": 55.48, "end": 84.9 },
    { "id": "t55", "scene": "s06", "kind": "caption", "text": "直す", "start": 55.54, "end": 84.9 },
    { "id": "t56", "scene": "s06", "kind": "caption", "text": "架空の 6 人で通す", "start": 55.6, "end": 84.9 },
    { "id": "t57", "scene": "s06", "kind": "caption", "text": "何を作るかは、人が PRD で決める", "start": 55.7, "end": 61.4 },
    { "id": "t58", "scene": "s06", "kind": "caption", "text": "Workflow が、決まった順にエージェントを動かす", "start": 61.6, "end": 70.0 },
    { "id": "t59", "scene": "s06", "kind": "caption", "text": "不合格にして、直して、流し直す", "start": 70.2, "end": 77.0 },
    { "id": "t60", "scene": "s06", "kind": "label", "text": "1 回目（2026-11-03 05:58）", "start": 70.4, "end": 77.0 },
    { "id": "t61", "scene": "s06", "kind": "caption", "text": "褒めすぎ 1 件（27 中）", "start": 70.5, "end": 77.0 },
    { "id": "t62", "scene": "s06", "kind": "label", "text": "2 回目（2026-11-03 06:29）", "start": 72.6, "end": 77.0 },
    { "id": "t63", "scene": "s06", "kind": "caption", "text": "褒めすぎ 0 件（27 中）", "start": 72.7, "end": 77.0 },
    { "id": "t64", "scene": "s06", "kind": "caption", "text": "架空の 6 人を AI が演じ、画面を最後まで通す", "start": 77.2, "end": 84.9 },
    { "id": "t65", "scene": "s06", "kind": "label", "text": "main に入れた PR 30 本", "start": 77.6, "end": 84.9 },
    { "id": "t66", "scene": "s06", "kind": "label", "text": "評価の記録 23 件", "start": 77.66, "end": 84.9 },
    { "id": "t67", "scene": "s06", "kind": "label", "text": "架空のエピソード 47 件", "start": 77.72, "end": 84.9 },

    { "id": "t70", "scene": "s07", "kind": "caption", "text": "初めは育児で、次は介護などで中断した人へ", "start": 85.1, "end": 89.6 },
    { "id": "t71", "scene": "s07", "kind": "title", "text": "キャリアには空白があっても、人生に空白はない。", "start": 89.7, "end": 94.9 },
    { "id": "t72", "scene": "s07", "kind": "title", "text": "RE:VALUE", "start": 91.6, "end": 94.9 }
